# Referencia de variables de conexión a MySQL para el proyecto Pavanamoon.
# La aplicación web usa realmente web/.env.example (copiar como web/.env).
# Este archivo de la raíz documenta las mismas variables para quien solo
# vaya a ejecutar los scripts SQL sin levantar la app web.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pavanamoon
DB_USER=pavanamoon_app
DB_PASSWORD=change_me

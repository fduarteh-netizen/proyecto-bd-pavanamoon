# Copiar como web/.env y completar con valores reales.
# NUNCA subir .env con credenciales reales al repositorio (estandar R6).

# Conexion a MySQL (misma base creada con sql/ddl/)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pavanamoon
DB_USER=pavanamoon_app
DB_PASSWORD=change_me

# Servidor web
WEB_PORT=3000

# Entorno: development en tu PC; production en el servidor desplegado.
# En production la app NO arranca si SESSION_SECRET es inseguro, y la cookie
# de sesion solo viaja por HTTPS.
NODE_ENV=development

# Sesiones: minimo 32 caracteres aleatorios. Generar uno en PowerShell con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se deja este valor de ejemplo, en desarrollo se usa uno temporal.
SESSION_SECRET=change_this_to_a_random_long_string

# Poner 1 solo si la app corre detras de un proxy HTTPS (Railway, Render...).
TRUST_PROXY=0

# Proteccion CSRF: origenes extra desde los que se aceptan formularios, separados
# por coma, si el dominio publico no llega en el encabezado Host. Ejemplo:
#   ORIGENES_PERMITIDOS=https://pavanamoon.ejemplo.com
# En produccion se rechaza todo POST sin Origin ni Referer.
ORIGENES_PERMITIDOS=

# IMPORTANTE: las sesiones y el limite de intentos viven en la memoria del
# proceso. Desplegar con UNA sola instancia (replicas = 1). Con varias
# instancias las sesiones no se comparten y el limite se multiplica.

# Limite de intentos fallidos de inicio de sesion (opcional).
LOGIN_MAX_INTENTOS=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_BLOQUEO_MINUTOS=15

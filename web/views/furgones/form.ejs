<%- include('../partials/header') %>

<% const editando = furgon && furgon.furgon_id; %>
<% const fecha = furgon && furgon.fecha_llegada ? (furgon.fecha_llegada instanceof Date ? furgon.fecha_llegada.toISOString().slice(0, 10) : furgon.fecha_llegada) : ''; %>
<h1><%= editando ? 'Editar furgón' : 'Nuevo furgón' %></h1>

<% if (errores && errores.length) { %>
  <div class="alert alert-error"><ul><% errores.forEach(function(e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<form action="<%= editando ? '/furgones/' + furgon.furgon_id + '?_method=PUT' : '/furgones' %>" method="POST" class="form">
  <label for="numero_furgon">Número de furgón</label>
  <input type="text" id="numero_furgon" name="numero_furgon" maxlength="30" required value="<%= furgon ? furgon.numero_furgon : '' %>" />

  <label for="fecha_llegada">Fecha de llegada</label>
  <input type="date" id="fecha_llegada" name="fecha_llegada" required value="<%= fecha %>" />

  <label for="procedencia">Procedencia</label>
  <input type="text" id="procedencia" name="procedencia" maxlength="100" value="<%= furgon ? (furgon.procedencia || '') : '' %>" />

  <label for="transportista">Transportista</label>
  <input type="text" id="transportista" name="transportista" maxlength="100" value="<%= furgon ? (furgon.transportista || '') : '' %>" />

  <label for="estado">Estado</label>
  <select id="estado" name="estado" required>
    <% ['en_transito', 'recibido', 'cancelado'].forEach(function(e) { %>
      <option value="<%= e %>" <%= furgon && furgon.estado === e ? 'selected' : '' %>><%= e %></option>
    <% }); %>
  </select>

  <button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Crear furgón' %></button>
  <a href="/furgones" class="btn-link">Cancelar</a>
</form>

<%- include('../partials/footer') %>

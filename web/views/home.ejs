<%- include('partials/header') %>

<h1>Bienvenido, <%= usuarioActual.nombre_completo %></h1>
<p>Rol: <strong><%= usuarioActual.rol %></strong> &middot; Solo ves los módulos que tu rol tiene permitidos.</p>

<div class="card-grid">
  <% modulosMenu.forEach(function(m) { %>
  <a class="card" href="<%= m.ruta %>">
    <h2><%= m.titulo %></h2>
    <p><%= m.descripcion %></p>
  </a>
  <% }); %>
</div>

<p class="note">
  Avance Entrega 3 (~70%). Pendiente para Entrega 4: administración de usuarios/empleados,
  reportes consolidados y despliegue (ver <code>docs/entrega-3/AVANCE_WEB.md</code>).
</p>

<%- include('partials/footer') %>

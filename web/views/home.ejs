<%- include('partials/header') %>

<h1>Bienvenido, <%= usuarioActual.nombre_completo %></h1>
<p>Rol: <strong><%= usuarioActual.rol %></strong> &middot; Solo ves los módulos que tu rol tiene permitidos.</p>

<div class="card-grid">
  <% modulosMenu.forEach(function(m) { %>
  <a class="card" href="<%= m.ruta %>">
    <h2><%= m.titulo %></h2>
    <p><%= m.descripcion %></p>
  </a>
  <% }); %>
</div>

<p class="note">
  Sistema de inventario y distribución de calzado de fútbol Pavanamoon ·
  Universidad Mariano Gálvez de Guatemala · Proyecto de Base de Datos 2026.
</p>

<%- include('partials/footer') %>
